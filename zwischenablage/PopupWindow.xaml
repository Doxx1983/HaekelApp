<Window x:Class="Zwischenablage.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zwischenablage"
        Title="Zwischenablage" Width="420" Height="520"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="10" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBox x:Name="Search" Padding="10,8" FontSize="14" BorderThickness="1"
                         Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                         Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" />
                <TextBlock Text="Suchen …" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource Muted}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0" Focusable="False"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="List_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:Item}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Thumb}" Visibility="{Binding ThumbVis}"
                                   Width="40" Height="40" Stretch="UniformToFill" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" TextWrapping="Wrap"
                                           MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="📌" Visibility="{Binding PinVis}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Margin="2,4,0,0" FontSize="11" Foreground="{DynamicResource Muted}"
                       Text="Enter einfügen · Strg+P anheften · Strg+Entf löschen · Esc schließen" />
        </Grid>
    </Border>
</Window>
