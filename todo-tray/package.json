{
  "name": "todo-tray",
  "version": "1.0.0",
  "description": "Gemeinsame To-do-Liste im Windows-Infobereich (Tray), Speicherung als JSON in einem geteilten Ordner",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/store.test.js && node test/sync.test.js",
    "dist": "electron-builder --win portable",
    "sync": "node -e \"require('fs').copyFileSync('shared/core.js','pwa/core.js')\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.todos.tray",
    "productName": "To-Dos",
    "files": [
      "src/**",
      "shared/**",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "icon": "icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
